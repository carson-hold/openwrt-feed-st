+/ {
+   model = "STMicroelectronics STM32MP135D-BP-256M BearPi Board";
+   compatible = "st,stm32mp135d-bp-256m", "st,stm32mp135";
+
+	aliases {
+		ethernet0 = &ethernet1;
+		ethernet1 = &ethernet2;
+		serial0 = &uart4;
+		serial1 = &uart7;
+		serial2 = &uart8;
+	};
+
+	memory@c0000000 {
+		device_type = "memory";
+		reg = <0xc0000000 0x10000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		optee_framebuffer@cd000000 {
+			reg = <0xcd000000 0x1000000>;
+			no-map;
+		};
+		optee@ce000000 {
+			reg = <0xce000000 0x2000000>;
+			no-map;
+		};
+	};
+
+};
+
+&sdmmc1 {
+	status = "disable";
+};
+
+/* eMMC */
+&sdmmc2 {
+	status = "disable";
+};
+
+&qspi {
+    pinctrl-names = "default", "sleep";
+    pinctrl-0 = <&quadspi_pins_mx>;
+    pinctrl-1 = <&quadspi_sleep_pins_mx>;
+    reg = <0x58003000 0x1000>,
+          <0x70000000 0x4000000>;
+	 dmas = <&mdma 22 0x2 0x10100002 0x0 0x0>,
+			<&mdma 22 0x2 0x10100008 0x0 0x0>;
+    #address-cells = <1>;
+    #size-cells = <0>;
+    status = "okay";
+
+    flash0: MX35LF2G24AD@0 {
+        compatible = "spi-nand";
+        reg = <0>;
+        spi-rx-bus-width = <4>;
+        spi-tx-bus-width = <4>;
+        spi-max-frequency = <108000000>;
+        #address-cells = <1>;
+        #size-cells = <1>;
+        partitions {
+            compatible = "fixed-partitions";
+            #address-cells = <1>;
+            #size-cells = <1>;
+
+            partition@0 {
+                label = "fsbl1";
+                reg = <0x00000000 0x00080000>;
+                read-only;
+            };
+            partition@80000 {
+                label = "fsbl2";
+                reg = <0x00080000 0x00080000>;
+                read-only;
+            };
+            partition@100000 {
+                 label = "metadata1";
+                 reg = <0x00100000 0x00080000>;
+                 read-only;
+             };
+             partition@180000 {
+                 label = "metadata2";
+                 reg = <0x00180000 0x00080000>;
+                 read-only;
+             };
+             partition@200000 {
+                 label = "fip-a1";
+                 reg = <0x00200000 0x00400000>;
+                 read-only;
+             };
+             partition@600000 {
+                 label = "fip-a2";
+                 reg = <0x00600000 0x00400000>;
+                 read-only;
+             };
+
+            partition@1200000 {
+                label = "UBI";
+                reg = <0x01200000 0x0ee00000>;
+            };
+        };
+    };
+};
diff -uNr a/arch/arm/boot/dts/st/bp-stm32mp135d-512m.dts b/arch/arm/boot/dts/st/bp-stm32mp135d-512m.dts
--- a/arch/arm/boot/dts/st/bp-stm32mp135d-512m.dts	1970-01-01 00:00:00.000000000 +0000
+++ b/arch/arm/boot/dts/st/bp-stm32mp135d-512m.dts	2025-04-22 03:42:15.912494950 +0000
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
